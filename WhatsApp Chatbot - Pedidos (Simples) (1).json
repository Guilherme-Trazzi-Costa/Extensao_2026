          ]
        }
      },
      "id": "356e21a8-b46c-48fe-818a-1f486a51be61",
      "name": "Buscar sessão",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        32,
        176
      ],
      "credentials": {
        "supabaseApi": {
          "id": "d9VLkMGW5DzoBb4r",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const msg = $('Extrair mensagem').first().json;\nconst sessao = $input.first().json?.[0] ?? null;\nconst step = sessao?.step ?? 'inicio';\nconst text = msg.text.toLowerCase();\n\nconst catalogo = [\n  { id: 1, nome: 'X-Burguer',  preco: 22.90 },\n  { id: 2, nome: 'X-Bacon',    preco: 28.90 },\n  { id: 3, nome: 'X-Salada',   preco: 25.90 },\n  { id: 4, nome: 'Fritas P',   preco: 10.00 },\n  { id: 5, nome: 'Refrigerante', preco: 7.00 }\n];\n\nlet resposta = '';\nlet novoStep = step;\nlet dados = sessao?.dados ? JSON.parse(sessao.dados) : {};\n\nif (step === 'inicio') {\n  const lista = catalogo.map(p => `*${p.id}.* ${p.nome} — R$ ${p.preco.toFixed(2).replace('.',',')}`).join('\\n');\n  resposta = `Olá, *${msg.name}*! 👋\\n\\nEscolha um produto:\\n\\n${lista}\\n\\nDigite o *número* do produto:`;\n  novoStep = 'produto';\n  dados = {};\n\n} else if (step === 'produto') {\n  const escolha = catalogo.find(p => p.id === parseInt(text));\n  if (!escolha) {\n    resposta = '❌ Número inválido. Digite o número do produto desejado.';\n  } else {\n    dados.produto = escolha;\n    resposta = `*${escolha.nome}* selecionado!\\n\\nQuantas unidades?`;\n    novoStep = 'quantidade';\n  }\n\n} else if (step === 'quantidade') {\n  const qtd = parseInt(text);\n  if (isNaN(qtd) || qtd < 1) {\n    resposta = '❌ Quantidade inválida. Digite um número maior que 0.';\n  } else {\n    dados.quantidade = qtd;\n    const total = (dados.produto.preco * qtd).toFixed(2).replace('.',',');\n    resposta = `${qtd}x ${dados.produto.nome} = *R$ ${total}*\\n\\nForma de pagamento:\\n*1.* PIX\\n*2.* Cartão\\n*3.* Dinheiro\\n\\nDigite o número:`;\n    novoStep = 'pagamento';\n  }\n\n} else if (step === 'pagamento') {\n  const formas = { '1': 'PIX', '2': 'Cartão', '3': 'Dinheiro' };\n  const pg = formas[text];\n  if (!pg) {\n    resposta = '❌ Opção inválida. Digite 1, 2 ou 3.';\n  } else {\n    dados.pagamento = pg;\n    const total = (dados.produto.preco * dados.quantidade).toFixed(2).replace('.',',');\n    resposta = `📋 *Resumo do pedido*\\n───────────────\\n${dados.quantidade}x ${dados.produto.nome}\\nTotal: *R$ ${total}*\\nPagamento: ${pg}\\n───────────────\\nConfirma? *SIM* ou *NÃO*`;\n    novoStep = 'confirmacao';\n  }\n\n} else if (step === 'confirmacao') {\n  if (text === 'sim') {\n    const total = (dados.produto.preco * dados.quantidade).toFixed(2);\n    dados.total = total;\n    dados.confirmado = true;\n    resposta = `✅ *Pedido confirmado!*\\n\\nPreparando seu pedido... Em breve entraremos em contato. 🙏`;\n    novoStep = 'inicio';\n  } else if (text === 'não' || text === 'nao') {\n    resposta = '❌ Pedido cancelado. Para novo pedido, é só mandar *oi*!';\n    novoStep = 'inicio';\n    dados = {};\n  } else {\n    resposta = 'Digite *SIM* para confirmar ou *NÃO* para cancelar.';\n  }\n} else {\n  resposta = 'Para iniciar um pedido, envie *oi*!';\n  novoStep = 'inicio';\n}\n\nreturn [{\n  json: {\n    phone: msg.phone,\n    name: msg.name,\n    resposta,\n    novoStep,\n    dados,\n    sessaoExiste: !!sessao,\n    salvarPedido: dados.confirmado === true\n  }\n}];"
      },
