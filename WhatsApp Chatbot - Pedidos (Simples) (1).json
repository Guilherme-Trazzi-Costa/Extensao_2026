{
  "name": "WhatsApp Chatbot - Pedidos (Simples)",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\n\nconst msg = body?.entry?.[0]?.changes?.[0]?.value?.messages?.[0];\nconst contact = body?.entry?.[0]?.changes?.[0]?.value?.contacts?.[0];\n\nif (!msg) {\n  return [{\n    json: {\n      erro: 'Nenhuma mensagem encontrada',\n      body_recebido: body\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    phone: msg.from || '',\n    text: (msg.text?.body || '').trim(),\n    name: contact?.profile?.name || 'Cliente'\n  }\n}];"
      },
      "id": "18a33b0c-b84e-4922-a498-038a68bdcd5b",
      "name": "Extrair mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -192,
        176
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "tableId": "sessoes",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "keyValue": "={{ $execution.id }}"
