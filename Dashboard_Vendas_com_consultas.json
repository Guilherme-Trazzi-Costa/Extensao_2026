      "id": "f6a7b8c9-4d5e-6f70-c182-3d4e5f607182",
      "name": "Buscar Metas",
      "credentials": { "supabaseApi": { "id": "d9VLkMGW5DzoBb4r", "name": "Supabase account" } }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const tipo = $('AI Agent').item.json.output.tipo_consulta;\nconst linhas = $input.all().map(item => item.json);\n\nconst hoje = new Date();\nconst anoAtual = hoje.getFullYear();\nconst mesAtual = hoje.getMonth() + 1;\n\nconst doMes = linhas.filter(r => {\n  const d = new Date(r.data);\n  return d.getFullYear() === anoAtual && (d.getMonth() + 1) === mesAtual;\n});\n\nfunction formatarBRL(v) {\n  return 'R$ ' + Math.abs(v).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n}\n\nlet texto = '';\n\nif (tipo === 'vendas_mes') {\n  const totalVendas = doMes.filter(r => r.valor > 0).reduce((s, r) => s + r.valor, 0);\n  texto = `Você vendeu ${formatarBRL(totalVendas)} este mês. 🥐`;\n} else {\n  const saldo = doMes.reduce((s, r) => s + r.valor, 0);\n  if (saldo >= 0) {\n    texto = `O saldo deste mês está positivo: ${formatarBRL(saldo)}. ✅`;\n  } else {\n    texto = `O saldo deste mês está negativo: -${formatarBRL(Math.abs(saldo))}. ⚠️`;\n  }\n}\n\nreturn [{ json: { output: texto } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [672, 592],
      "id": "a7b8c9d0-5e6f-7081-d293-4e5f60718293",
      "name": "Calcular Consulta Financeira"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const linhas = $input.all().map(item => item.json);\n\nconst concluidas = linhas.filter(r => (r.obs || '').toUpperCase().trim() === 'CONCLUÍDO');\nconst pendentes = linhas.filter(r => (r.obs || '').toUpperCase().trim() !== 'CONCLUÍDO');\n\nfunction formatarBRL(v) {\n  return 'R$ ' + Math.abs(v).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n}\n\nconst totalInvestido = concluidas.reduce((s, r) => s + Number(r.preco || 0), 0);\nconst totalPendente = pendentes.reduce((s, r) => s + Number(r.preco || 0), 0);\n\nlet texto = `Você tem ${linhas.length} meta(s) no total: ${concluidas.length} concluída(s) e ${pendentes.length} pendente(s).`;\ntexto += ` Já investiu ${formatarBRL(totalInvestido)} em metas concluídas`;\nif (pendentes.length > 0) {\n  texto += ` e falta ${formatarBRL(totalPendente)} para completar as pendentes.`;\n} else {\n  texto += '. Todas as metas foram concluídas! 🎉';\n}\n\nreturn [{ json: { output: texto } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [672, 720],
      "id": "b8c9d0e1-6f70-8192-e3a4-5f6071829304",
      "name": "Calcular Progresso Metas"
    }
